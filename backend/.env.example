# These are shell environment variables; Spring does not load .env automatically.
DATABASE_URL=jdbc:postgresql://localhost:5432/askpool
DATABASE_USER=askpool_app
DATABASE_PASSWORD=
# Enable once only when adopting the exact supplied V1 schema; default false.
DATABASE_BASELINE=false
# Local opt-in; the hackathon deployment enables this by default.
APP_TESTING_PERMISSIONS=true
